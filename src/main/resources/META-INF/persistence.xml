<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
	version="3.0">

	<persistence-unit name="LoanPu">


		<class>com.loan.entity.ApplicationReview</class>
		<class>com.loan.entity.Customer</class>
		<class>com.loan.entity.Loan</class>
		<class>com.loan.entity.LoanApplication</class>
		<class>com.loan.entity.Payment</class>
		<class>com.loan.entity.Staff</class>
		<class>com.loan.entity.User</class>

		<properties>
			<property name="jakarta.persistence.jdbc.driver"
				value="org.postgresql.Driver" />

			<property name="jakarta.persistence.jdbc.url"
				value="jdbc:postgresql://localhost:5432/bank_loan_db" />

			<property name="jakarta.persistence.jdbc.user"
				value="postgres" />

			<property name="jakarta.persistence.jdbc.password"
				value="root" />

			<property name="hibernate.dialect"
				value="org.hibernate.dialect.PostgreSQLDialect" />

			<property name="hibernate.show_sql" value="true" />

			<property name="hibernate.format_sql" value="true" />

			<property name="hibernate.hbm2ddl.quto" value="validate" />



		</properties>


	</persistence-unit>



</persistence>